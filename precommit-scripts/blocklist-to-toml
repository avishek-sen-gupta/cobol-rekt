#!/usr/bin/env python3
"""blocklist-to-toml — convert the terminology blocklist into a betterleaks rules file.

Reads ~/.config/git/blocklist.txt (one regex per line, '#' comments) and the
optional ~/.config/git/blocklist-exclude.txt (git pathspec globs), and prints a
betterleaks TOML config to stdout:

  - one [[rules]] entry matching any blocklist term, case-insensitively
  - a global prefilter that skips paths matching the exclude globs

Usage:
  blocklist-to-toml > ~/.config/git/terminology.toml
"""

import os
import re
import sys

GIT_CONFIG = os.path.join(os.path.expanduser("~"), ".config", "git")
BLOCKLIST = os.path.join(GIT_CONFIG, "blocklist.txt")
EXCLUDELIST = os.path.join(GIT_CONFIG, "blocklist-exclude.txt")


def read_entries(path: str) -> list[str]:
    with open(path) as f:
        lines = [line.strip() for line in f]
    return [line for line in lines if line and not line.startswith("#")]


def glob_to_regex(glob: str) -> str:
    """Translate a git pathspec glob to an anchored RE2 regex.

    Matches git's default pathspec semantics: '*' and '?' also match '/', and a
    pattern naming a directory matches everything beneath it.
    """
    out = []
    i = 0
    while i < len(glob):
        c = glob[i]
        if c == "*":
            out.append(".*")
        elif c == "?":
            out.append(".")
        elif c == "[" and "]" in glob[i + 1 :]:
            end = glob.index("]", i + 1)
            body = glob[i + 1 : end]
            if body.startswith("!"):
                body = "^" + body[1:]
            out.append("[" + body + "]")
            i = end
        else:
            out.append(re.escape(c))
        i += 1
    return "^" + "".join(out).rstrip("/") + "(?:/.*)?$"


def fail(message: str) -> None:
    print(f"blocklist-to-toml: {message}", file=sys.stderr)
    sys.exit(1)


def main() -> None:
    if not os.path.isfile(BLOCKLIST):
        fail(f"no blocklist found at {BLOCKLIST}")
    terms = read_entries(BLOCKLIST)
    if not terms:
        fail(f"blocklist at {BLOCKLIST} has no terms")
    for term in terms:
        if "'''" in term:
            fail(f"term contains ''' and cannot be written as a TOML literal: {term!r}")
        try:
            re.compile(term)
        except re.error as e:
            fail(f"invalid regex {term!r}: {e}")

    excludes = read_entries(EXCLUDELIST) if os.path.isfile(EXCLUDELIST) else []
    exclude_regexes = [glob_to_regex(g) for g in excludes]
    for g, rx in zip(excludes, exclude_regexes):
        if "`" in rx:
            fail(f"exclude glob contains a backtick: {g!r}")

    out = ["# Generated by blocklist-to-toml from ~/.config/git/blocklist.txt", ""]
    if exclude_regexes:
        quoted = ", ".join(f"`{rx}`" for rx in exclude_regexes)
        out += [
            "prefilter = '''",
            f'filter.matchesAny(attributes["path"], [{quoted}])',
            "'''",
            "",
        ]
    out += [
        "[[rules]]",
        'id = "forbidden-term"',
        'description = "Forbidden terminology from blocklist.txt"',
        "regex = '''(?i)(?:" + "|".join(terms) + ")'''",
    ]
    print("\n".join(out))


if __name__ == "__main__":
    main()
